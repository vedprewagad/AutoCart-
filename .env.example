# ====================================================================
# AutoCart Platform Environment Variables
# 
# NOTE: This file is an example template for system environment variables.
# Spring Boot does NOT automatically load .env files by default.
# You must export these variables in your shell (e.g. via PowerShell $env:VAR = "value"
# or export VAR="value") or configure them in your IDE launch configuration.
# ====================================================================

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/autocart_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Database Logging (Optional, default: false)
SHOW_SQL=false

# Service Ports (Optional overrides)
# PORT=8081  # auth-service
# PORT=8082  # business-service
# PORT=8083  # transaction-service
# PORT=8084  # ai-service

# JWT Authentication (REQUIRED: 256-bit secret, min 32 chars, fail-fast on startup)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRATION=86400000
JWT_COOKIE_SECURE=false

# Service Discovery & Internal Routing
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
CORS_ALLOWED_ORIGINS=http://localhost:5173
cors.allowed-origins=http://localhost:5173,http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
BUSINESS_SERVICE_URL=http://localhost:8082

# AI Chatbot Service (Required for AI assistant features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Mail / Password Reset Delivery (Optional - needed for sending reset email via Gmail SMTP)
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Optional Seed Password Overrides (Defaults in code: admin123, dealer123, buyer123)
SEED_ADMIN_PASSWORD=admin123
SEED_DEALER_PASSWORD=dealer123
SEED_CUSTOMER_PASSWORD=buyer123
